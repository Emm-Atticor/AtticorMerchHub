# --- Auth (NextAuth v5 / Auth.js) ---
AUTH_SECRET=            # openssl rand -base64 32
AUTH_URL=http://localhost:3000
# Google Workspace SSO — the likely real path, since staff are on Workspace
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Database (Vercel Postgres / Neon) ---
DATABASE_URL=
DIRECT_URL=             # unpooled connection, used by Prisma migrations

# --- File storage for brand guidelines + merch photos ---
BLOB_READ_WRITE_TOKEN=  # Vercel Blob

# --- Optional: transactional email for approval notifications ---
RESEND_API_KEY=
